<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMaterial3CustomizationSample.MainPage"
             Title="Material 3">

    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="14">
            <Label Text="Custom Material 3"
                   x:Name="PageTitleLabel"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Label Text="This page shows both Android Material 3 theme colors and MAUI XAML resources."
                   FontSize="14" />

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="MAUI Colors.xaml resources"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}" />

                    <Label Text="This card, these swatches, and the button below are explicitly styled from Resources/Styles/Colors.xaml."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                HeightRequest="52"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                        </Border>
                        <Border Grid.Column="1"
                                HeightRequest="52"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                        </Border>
                        <Border Grid.Column="2"
                                HeightRequest="52"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                        </Border>
                    </Grid>

                    <Button Text="XAML styled action"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}"
                            CornerRadius="22"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Android colors.xml Material 3 theme"
                   FontAttributes="Bold" />

            <Label Text="The controls below are not explicitly colored in XAML. Their teal accents come from Android m3_sys_color_* values in colors.xml."
                   FontSize="13" />

            <SearchBar Placeholder="Search health goals" />

            <Entry Placeholder="Name"
                   Text="Gerald" />

            <Editor Placeholder="Notes"
                    Text="Training for a 10K and keeping hydration on track."
                    AutoSize="TextChanges"
                    HeightRequest="72" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <DatePicker x:Name="CheckupDatePicker"
                            Grid.Column="0" />
                <TimePicker x:Name="ReminderTimePicker"
                            Grid.Column="1" />
            </Grid>

            <Picker x:Name="GoalPicker"
                    Title="Primary goal">
                <Picker.Items>
                    <x:String>Build strength</x:String>
                    <x:String>Improve sleep</x:String>
                    <x:String>Run faster</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Daily progress"
                   FontAttributes="Bold" />

            <ProgressBar Progress="0.68" />

            <Slider Minimum="0"
                    Maximum="100"
                    Value="68" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <CheckBox IsChecked="True" />
                <Label Grid.Column="1"
                       Text="Sync activity automatically"
                       VerticalOptions="Center" />

                <Switch Grid.Row="1"
                        IsToggled="True" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="Enable daily reminders"
                       VerticalOptions="Center" />
            </Grid>

            <HorizontalStackLayout Spacing="16">
                <RadioButton Content="Light"
                             GroupName="Theme"
                             IsChecked="True" />
                <RadioButton Content="Dark"
                             GroupName="Theme" />
            </HorizontalStackLayout>

            <Button Text="Save profile"
                    HeightRequest="54"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
