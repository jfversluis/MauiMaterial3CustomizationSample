<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        MAUI/XAML resources for cross-platform styling.
        For Android's native Material 3 theme, see Platforms\Android\Resources\values\colors.xml.
    -->

    <!-- Material 3 semantic palette for MAUI controls and layouts. -->
    <Color x:Key="Primary">#006A6A</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#6FF7F7</Color>
    <Color x:Key="OnPrimaryContainer">#002020</Color>

    <Color x:Key="PrimaryDark">#4CDADA</Color>
    <Color x:Key="OnPrimaryDark">#003737</Color>
    <Color x:Key="PrimaryContainerDark">#004F4F</Color>
    <Color x:Key="OnPrimaryContainerDark">#6FF7F7</Color>

    <Color x:Key="Secondary">#4A6363</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="SecondaryContainer">#CCE8E7</Color>
    <Color x:Key="OnSecondaryContainer">#051F1F</Color>

    <Color x:Key="SecondaryDark">#B0CCCB</Color>
    <Color x:Key="OnSecondaryDark">#1B3434</Color>
    <Color x:Key="SecondaryContainerDark">#324B4B</Color>
    <Color x:Key="OnSecondaryContainerDark">#CCE8E7</Color>

    <Color x:Key="SurfaceLight">#F4FBFA</Color>
    <Color x:Key="SurfaceContainerLight">#DAE5E3</Color>
    <Color x:Key="SurfaceVariantLight">#DAE5E3</Color>
    <Color x:Key="OnSurfaceLight">#161D1D</Color>
    <Color x:Key="OnSurfaceVariantLight">#3F4948</Color>
    <Color x:Key="OutlineLight">#6F7978</Color>
    <Color x:Key="OutlineVariantLight">#BEC9C8</Color>

    <Color x:Key="SurfaceDark">#0E1515</Color>
    <Color x:Key="SurfaceContainerDark">#1A2221</Color>
    <Color x:Key="SurfaceVariantDark">#3F4948</Color>
    <Color x:Key="OnSurfaceDark">#DEE4E3</Color>
    <Color x:Key="OnSurfaceVariantDark">#BEC9C8</Color>
    <Color x:Key="OutlineDark">#899392</Color>
    <Color x:Key="OutlineVariantDark">#3F4948</Color>

    <!-- Backwards-compatible aliases. -->
    <Color x:Key="PrimaryDarkText">#003737</Color>
    <Color x:Key="SecondaryDarkText">#DEE4E3</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#006A6A</Color>
    <Color x:Key="MidnightBlue">#161D1D</Color>
    <Color x:Key="OffBlack">#0E1515</Color>

    <Color x:Key="Gray100">#F4FBFA</Color>
    <Color x:Key="Gray200">#DAE5E3</Color>
    <Color x:Key="Gray300">#BEC9C8</Color>
    <Color x:Key="Gray400">#899392</Color>
    <Color x:Key="Gray500">#6F7978</Color>
    <Color x:Key="Gray600">#4A6363</Color>
    <Color x:Key="Gray900">#161D1D</Color>
    <Color x:Key="Gray950">#0E1515</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}"/>
    <SolidColorBrush x:Key="SurfaceContainerLightBrush" Color="{StaticResource SurfaceContainerLight}"/>
    <SolidColorBrush x:Key="SurfaceContainerDarkBrush" Color="{StaticResource SurfaceContainerDark}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
